# ===== GLM 质量研判节点配置 =====
# 智谱 GLM API Key。配置后质量研判节点真实调用 GLM 大模型；
# 留空或不配置时，研判节点自动降级为规则研判，结果会标注 decisionEngine=rule-fallback。
# 获取方式：https://open.bigmodel.cn/ 控制台 -> API Keys
GLM_API_KEY=

# GLM 模型名。可选 glm-4 / glm-4-plus / glm-4-flash / glm-4-long 等。
GLM_MODEL=glm-4

# GLM API 地址。默认智谱官方，可换成自建网关。
GLM_API_BASE=https://open.bigmodel.cn/api/paas/v4/chat/completions

# GLM 调用超时（毫秒），超时后降级到规则研判。
GLM_TIMEOUT_MS=30000

# ===== 服务配置 =====
# 本地服务端口
PORT=8787

# Python 解释器（用于读取 SQLite 样例库）
PYTHON=python3
